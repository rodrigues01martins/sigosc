# ============================================================
# Variáveis de ambiente CLIENT-SIDE (Vite) — src/config/firebaseConfig.js
# ============================================================
# Configuração do app web do projeto Firebase do SIGOSC (sigosc-8f529).
# Estes valores NÃO são segredos: o Vite os embute no bundle público do
# navegador, e a proteção dos dados vem do Firebase Authentication e das
# regras do Firestore. Por isso já vêm preenchidos aqui.
#
# Local: copie este arquivo para `.env` (ignorado pelo git).
# Vercel: cadastre as 6 variáveis em Project Settings → Environment Variables
# (Production, Preview e Development) ANTES do build — o Vite as lê em
# tempo de build.
#
# O app valida estes valores ao iniciar e se recusa a rodar se algum
# faltar ou apontar para outro projeto Firebase (sem fallback).
VITE_FIREBASE_API_KEY=AIzaSyCUh1BI1-irmOHYleSatMhSwH9bzQhTnzc
VITE_FIREBASE_AUTH_DOMAIN=sigosc-8f529.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sigosc-8f529
VITE_FIREBASE_STORAGE_BUCKET=sigosc-8f529.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=559907813043
VITE_FIREBASE_APP_ID=1:559907813043:web:f744dfb215dc900e84e2c6

# ============================================================
# Variáveis de ambiente SERVER-SIDE (Vercel) — api/admin/create-user
# ============================================================
# Cadastrar em: Vercel → Project Settings → Environment Variables.
# NUNCA usar o prefixo VITE_ nestas — variáveis VITE_* são embutidas no
# bundle do navegador pelo Vite e ficariam públicas.
#
# Nunca commitar este arquivo com valores reais preenchidos NESTA seção — ele existe
# só para documentar os NOMES esperados (.env real já está no
# .gitignore).

# Credenciais da conta de serviço do Firebase Admin (Firebase Console do
# projeto sigosc-8f529 → Configurações do projeto → Contas de serviço → Gerar nova chave privada).
# Precisa ser exatamente sigosc-8f529 — outro valor é recusado pelo servidor.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Cole a private key exatamente como veio do JSON da conta de serviço —
# o código já trata o caso de \n literal (linha única) automaticamente.
FIREBASE_ADMIN_PRIVATE_KEY=

# Mesmo e-mail já usado em src/firebase.ts (BOOTSTRAP_ADMIN_EMAIL) e em
# firestore.rules (isAdmin()) — precisa ser idêntico nos três lugares.
BOOTSTRAP_ADMIN_EMAIL=
